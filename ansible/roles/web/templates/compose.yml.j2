version: '3.8'
services:
  nginx-exporter:
    image: quay.io/martinhelmich/prometheus-nginxlog-exporter:{{ nginx_exporter_version }}
    container_name: course-nginx-exporter
    user: '0:0'
    restart: unless-stopped
    network_mode: host
    command: ["-config-file", "/etc/nginx-exporter.hcl"]
    volumes:
      - /opt/course/nginx-exporter.hcl:/etc/nginx-exporter.hcl:ro
      - /var/log/nginx:/var/log/nginx:ro
